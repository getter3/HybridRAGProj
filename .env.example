# Local PostgreSQL connection details. Keep DATABASE_PASSWORD only in your local
# .env file; never commit that file.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=paradedb
DATABASE_SCHEMA=SMT1db
DATABASE_USER=
DATABASE_PASSWORD=

# Embedding provider/model are intentionally left for the learner to choose.
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_REQUEST_TIMEOUT=30
EMBEDDING_RETRY_LIMIT=3
EMBEDDING_WAIT_TIME=5

# OpenRouter rerank API configuration.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_RERANK_MODEL=

# Ingestion and retrieval settings to decide and validate during implementation.
INGEST_SOURCE_DIR=./data
CHUNK_SIZE=256
CHUNK_OVERLAP=32
RETRIEVAL_LIMIT=
