# PostgreSQL connection string; configure only after provisioning your own database.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=paradedb
DATABASE_SCHEMA=SMT1db
DATABASE_USER=
DATABASE_PASSWORD=

# Embedding provider/model are intentionally left for the learner to choose.
EMBEDDING_API_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_REQUEST_TIMEOUT=30
EMBEDDING_RETRY_LIMIT=3
EMBEDDING_WAIT_TIME=5

# OpenRouter rerank API configuration.
RERANK_BASE_URL=https://openrouter.ai/api/v1/rerank
RERANK_API_KEY=
RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
RERANK_REQUEST_TIMEOUT=30
RERANK_RETRY_LIMIT=3
RERANK_WAIT_TIME=5

# Ingestion and retrieval settings to decide and validate during implementation.
INGEST_SOURCE_DIR=./data/org
CHUNK_SIZE=600
CHUNK_OVERLAP=80
RETRIEVAL_LIMIT=
